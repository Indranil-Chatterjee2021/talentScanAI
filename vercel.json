{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    { "src": "/api/ai", "dest": "/api/ai.ts" },
    { "src": "/api/candidates", "dest": "/api/candidates.ts" },
    { "src": "/api/reports", "dest": "/api/reports.ts" },
    { "src": "/api/settings", "dest": "/api/settings.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
