{
  "buildCommand": "npm run build --legacy-peer-deps",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/api/ai", "destination": "/api/ai.ts" },
    { "source": "/api/candidates", "destination": "/api/candidates.ts" },
    { "source": "/api/reports", "destination": "/api/reports.ts" },
    { "source": "/api/settings", "destination": "/api/settings.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
